
FROM rust:1.96-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /project

COPY . .

# Install rustfmt and clippy
RUN rustup component add rustfmt clippy

# Build
RUN cargo build --manifest-path crates/cli/Cargo.toml --release 2>&1 | tee /tmp/build.log

# Report
RUN echo "=== Build log ===" && tail -50 /tmp/build.log || true
